# MediNote-AI 老年人安全醫療對話框架 - 環境配置

# Flask 應用設定
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=your-secret-key-here
PORT=5000

# Redis 設定
REDIS_URL=redis://localhost:6379

# PHI 去識別化設定 (John Snow Labs)
JSL_PHI_API_KEY=demo-key
JSL_PHI_CONFIDENCE_THRESHOLD=0.9
JSL_PHI_MODEL_VERSION=latest

# HIPAA 合規設定
HIPAA_ENCRYPTION_KEY=your-encryption-key-here
HIPAA_DATA_RETENTION_DAYS=2555
HIPAA_AUDIT_RETENTION_DAYS=3652
HIPAA_ENCRYPTION_ENABLED=true
HIPAA_ACCESS_CONTROL_ENABLED=true
HIPAA_MIN_PASSWORD_LENGTH=8
HIPAA_SESSION_TIMEOUT=30
HIPAA_MAX_LOGIN_ATTEMPTS=5

# MediNote-AI 設定
MEDINOTE_MODEL_VERSION=1.0
MEDINOTE_CONFIDENCE_THRESHOLD=0.8
MEDINOTE_MAX_CONTEXT_LENGTH=2000

# Rocket.Chat 設定
ROCKET_CHAT_URL=https://demo.rocket.chat
ROCKET_CHAT_ADMIN_USER=admin
ROCKET_CHAT_ADMIN_PASSWORD=admin
ROCKET_CHAT_API_TOKEN=your-api-token-here

# 老年人介面設定
ELDERLY_FONT_SIZE=18
ELDERLY_HIGH_CONTRAST=true
ELDERLY_VOICE_ENABLED=true
ELDERLY_LARGE_BUTTONS=true
ELDERLY_SIMPLIFIED_INTERFACE=true
ELDERLY_EMERGENCY_HOTKEYS=true

# 語音辨識設定
GOOGLE_SPEECH_API_KEY=your-speech-api-key-here

# 日誌設定
LOG_LEVEL=INFO
LOG_FILE=logs/medinote-ai-elderly.log

# 資料庫設定 (可選)
DATABASE_URL=sqlite:///medinote_ai_elderly.db

# API 速率限制
API_RATE_LIMIT=100
API_RATE_LIMIT_PER_MINUTE=10

# 安全設定
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=300
SESSION_TIMEOUT=1800

# 監控設定
HEALTH_CHECK_INTERVAL=30
METRICS_ENABLED=true